# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=ganti-dengan-string-acak-panjang
ADMIN_TOKEN=ganti-dengan-token-admin-rahasia

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/polinema_mengajar

# CBT
CBT_DURATION_MINUTES=90
MAX_VIOLATIONS=3
# Peserta boleh mulai maksimal N menit setelah jadwal CBT
CBT_ENTRY_WINDOW_MINUTES=30
# Set true HANYA untuk uji coba lokal (abaikan jadwal CBT)
CBT_OPEN_ALWAYS=false

# SMTP (contoh: Gmail dengan App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=email-anda@gmail.com
SMTP_PASS=app-password-anda
MAIL_FROM="Polinema Mengajar <email-anda@gmail.com>"
